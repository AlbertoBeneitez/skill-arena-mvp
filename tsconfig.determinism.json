{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2020",
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "outDir": ".det-test",
    "noEmit": false,
    "incremental": false
  },
  "include": [
    "scripts/verify-competitive-games.ts",
    "scripts/verify-match-contracts.ts",
    "scripts/verify-scenarios.ts",
    "scripts/verify-match-repository.ts",
    "scripts/verify-submission-lifecycle.ts",
    "scripts/verify-core-runtime.ts",
    "scripts/verify-stack-v3.ts",
    "scripts/verify-tower-v3.ts",
    "scripts/verify-jet-v2.ts",
    "scripts/verify-serpent-v1.ts",
    "scripts/verify-river-v1.ts",
    "scripts/verify-river-v2.ts",
    "scripts/verify-ranking.ts",
    "scripts/verify-ranking-repository.ts",
    "scripts/verify-orb-v1.ts",
    "scripts/verify-mine-v1.ts",
    "scripts/verify-hidden-commands.ts",
    "scripts/verify-command-repository.ts",
    "scripts/verify-billiards-v1.ts",
    "scripts/verify-darts-v1.ts",
    "scripts/verify-gallery-v1.ts",
    "scripts/verify-alien-v2.ts"
  ],
  "exclude": [
    "node_modules",
    ".det-test"
  ]
}
