{
  "name": "skill-arena-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "check": "pnpm lint && pnpm test:determinism",
    "test:determinism": "node -e \"require('fs').rmSync('.det-test',{recursive:true,force:true})\" && tsc --project tsconfig.determinism.json && node scripts/run-determinism.mjs",
    "test:repository": "node scripts/verify-i18n.cjs && tsc --project tsconfig.determinism.json && node scripts/run-determinism.mjs repository",
    "test:i18n": "node scripts/verify-i18n.cjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "pg": "8.23.1",
    "qrcode-generator": "1.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@12.7.0"
}
