# Plantilla de configuración. Solo nombres y descripciones: NUNCA escribas valores
# reales aquí ni los subas al repositorio. Se definen en el entorno del servidor
# (en Vercel: Settings → Environment Variables, para Production y Preview).
# Descripción completa: README.md → «Configuración y despliegue».

# --- Obligatoria en producción -------------------------------------------------
# Clave de firma de los tickets de partida. Mínimo 32 caracteres aleatorios,
# p. ej. generada con: openssl rand -hex 32
# Sin ella los endpoints responden 503 (no se usa la clave pública de pruebas).
MATCH_SIGNING_SECRET=

# --- Entrenamiento sin base de datos (no guarda partidas) ------------------------
# 1 = mantener este modo en producción mientras no haya PostgreSQL.
ALLOW_LEGACY_STATELESS_TRAINING=

# --- PostgreSQL (opcional hasta que se contrate) ----------------------------------
# Fuera de localhost debe terminar en ?sslmode=verify-full
# Las migraciones de db/migrations/ se aplican a mano; nunca al arrancar.
DATABASE_URL=
# 1 = partidas duraderas (migraciones 001 y 003)
ALLOW_PERSISTED_MATCH_TRAINING=
# 1 = Mine Grid con tablero distinto en cada intento (migraciones 001 y 002)
ALLOW_PERSISTED_HIDDEN_TRAINING=
# Interruptores de funciones preparadas, aún sin activar en producción
RANKING_READ_MODEL_READY=
COMMAND_AUTHORITY_READY=

# --- Solo desarrollo y pruebas locales ---------------------------------------------
# QA local de juegos de información oculta (se ignora en Vercel)
ALLOW_LOCAL_HIDDEN_GAMES=
# Probar una build de producción en tu equipo con la clave pública (nunca en Vercel)
ALLOW_DEMO_SIGNING_KEY=
# Base de pruebas para: pnpm test:repository
TEST_DATABASE_URL=
