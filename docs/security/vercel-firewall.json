{
  "_note": "Copia de las reglas activas en Vercel › Firewall (aplicadas el 13-nov-2026, v185, config waf_HHaVubzFVaH9 versión 1). Si se pierden, se pueden volver a crear igual.",
  "firewallEnabled": true,
  "rules": [
    {
      "name": "Envios de estudios: 10 cada 10 min por IP",
      "conditionGroup": [{ "conditions": [{ "type": "path", "op": "eq", "value": "/api/studio/proposals" }, { "type": "method", "op": "eq", "value": "POST" }] }],
      "action": { "mitigate": { "action": "rate_limit", "rateLimit": { "algo": "fixed_window", "window": 600, "limit": 10, "keys": ["ip"], "action": "rate_limit" } } }
    },
    {
      "name": "API: 300 por minuto por IP",
      "conditionGroup": [{ "conditions": [{ "type": "path", "op": "pre", "value": "/api/" }] }],
      "action": { "mitigate": { "action": "rate_limit", "rateLimit": { "algo": "fixed_window", "window": 60, "limit": 300, "keys": ["ip"], "action": "rate_limit" } } }
    }
  ]
}
