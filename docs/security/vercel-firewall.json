{
  "_note": "Copia de las reglas en Vercel › Firewall (config waf_p378LWa2Wk5R versión 4, 13-nov-2026, v186). Si se pierden, se pueden volver a crear igual. El aviso de mantenimiento es automático (components/MaintenanceGate.tsx); no hay regla manual.",
  "firewallEnabled": true,
  "rules": [
    {
      "name": "Envios de estudios: 10 cada 10 min por IP",
      "conditionGroup": [
        {
          "conditions": [
            {
              "type": "path",
              "op": "pre",
              "value": "/api/studio/proposals"
            },
            {
              "type": "method",
              "op": "eq",
              "value": "POST"
            }
          ]
        }
      ],
      "action": {
        "mitigate": {
          "action": "rate_limit",
          "rateLimit": {
            "algo": "fixed_window",
            "window": 600,
            "limit": 10,
            "keys": [
              "ip"
            ],
            "action": "rate_limit"
          }
        }
      },
      "active": true
    },
    {
      "name": "API: 300 por minuto por IP",
      "conditionGroup": [
        {
          "conditions": [
            {
              "type": "path",
              "op": "pre",
              "value": "/api/"
            }
          ]
        }
      ],
      "action": {
        "mitigate": {
          "action": "rate_limit",
          "rateLimit": {
            "algo": "fixed_window",
            "window": 60,
            "limit": 300,
            "keys": [
              "ip"
            ],
            "action": "rate_limit"
          }
        }
      },
      "active": true
    }
  ]
}
